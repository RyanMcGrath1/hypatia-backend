# Copy to .env and set real values (never commit .env).
#
# Deployment / Flask
# HYPATIA_ENV=production            # or FLASK_ENV=production (default: development)
#
# SECRET_KEY — Flask / security secret (also used as HMAC key material for
# auth rate-limit account identifiers).
# Development may omit this and use a local insecure default.
# Production MUST set an explicit non-placeholder value; startup fails if it is
# missing, blank, or equal to the development placeholder
# "dev-insecure-change-me". Keep it private and stable across workers/restarts.
# Do not commit a real production secret.
# SECRET_KEY=replace-with-a-long-random-production-secret

# Database — SQLAlchemy URI
# When DATABASE_URL is unset, DevelopmentConfig already defaults to an absolute project-root hypatia.db path.
# DATABASE_URL=sqlite:///hypatia.db
# PostgreSQL example (swap in when ready; no application code changes required):
# DATABASE_URL=postgresql://user:password@localhost:5432/hypatia

# Auth — opaque session lifetime in days (default: 30)
# AUTH_SESSION_TTL_DAYS=30

# Auth rate limiting (Flask-Limiter)
# Development/testing may use in-process memory storage (default). Memory is NOT
# production-grade for multi-worker/multi-instance deployments — configure a
# shared backend (example Redis URI below) so counters are consistent across
# processes.
# AUTH_RATE_LIMIT_STORAGE_URI=memory://
# AUTH_RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
#
# Login: POST /api/auth/login — per-account (normalized email HMAC) + per-IP
# AUTH_LOGIN_ACCOUNT_LIMIT=10
# AUTH_LOGIN_ACCOUNT_WINDOW_MINUTES=15
# AUTH_LOGIN_IP_LIMIT=30
# AUTH_LOGIN_IP_WINDOW_MINUTES=15
#
# TOTP completion: POST /api/auth/login/totp — per-account (resolved user_id) +
# per-IP, in addition to the existing per-challenge attempt_count cap
# (TOTP_LOGIN_MAX_ATTEMPTS).
# AUTH_TOTP_ACCOUNT_LIMIT=10
# AUTH_TOTP_ACCOUNT_WINDOW_MINUTES=15
# AUTH_TOTP_IP_LIMIT=30
# AUTH_TOTP_IP_WINDOW_MINUTES=15
#
# Client IP for rate limiting uses request.remote_addr. Do not trust arbitrary
# X-Forwarded-For headers. If a reverse proxy/load balancer is introduced,
# configure trusted-proxy handling (e.g. Werkzeug ProxyFix) before relying on
# forwarded client IPs.

# TOTP MFA (authenticator app)
# Generate a Fernet key once and keep it stable across restarts (rotating it makes
# existing enrolled secrets undecryptable). Example:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not commit a real production key. Tests inject their own deterministic key.
TOTP_ENCRYPTION_KEY=
# TOTP_ISSUER_NAME=Hypatia
# TOTP_LOGIN_CHALLENGE_TTL_MINUTES=5
# TOTP_LOGIN_MAX_ATTEMPTS=5
#
# Before considering TOTP MFA production-complete, add an account-recovery
# mechanism (e.g. recovery codes). Without recovery, a user who permanently
# loses their authenticator device can be locked out. Do not weaken TOTP
# disable/login rules to compensate for missing recovery.

# Outbound email (SMTP) — required before account-security transactional mail works.
# SMTP_SECURITY: starttls (recommended) | ssl | none
# Do not use SMTP_SECURITY=none in production unless deliberately configuring a
# trusted local/relay path. Leave USERNAME/PASSWORD empty only if the relay
# allows unauthenticated submission.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Hypatia

# Email change — dual-confirmation opaque tokens (TTL enforced server-side; default: 8 hours)
# EMAIL_CHANGE_TOKEN_TTL_HOURS=8
# Frontend/deep-link base for confirmation emails; raw token is appended as ?token=...
EMAIL_CHANGE_VERIFY_URL=hypatia://verify-email-change

GOOGLE_CIVIC_API_KEY=your_google_civic_api_key_here

# FRED — required for economy dashboard routes and FRED proxies; https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# GNews — required for GET /api/news/top-headlines and GET /api/news/search; https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# OpenFEC — required for GET /api/fec/v1/names/candidates (alias: /api/fec/candidates); https://api.open.fec.gov/developers/
OPENFEC_API_KEY=your_openfec_api_key_here

# Optional: comma-separated extra CORS origins (e.g. https://xxxx.ngrok-free.app, http://myhost.local:8081)
# EXPO_CORS_EXTRA_ORIGINS=

# Optional: set to 1 for local dev only — allow any Origin (do not use in production)
# CORS_ALLOW_ALL_ORIGINS=

# Optional: override Flask listen port (default 5001 — avoids macOS AirPlay on 5000)
# PORT=5001

# Logging — optional (defaults: LOG_LEVEL=INFO, LOG_FORMAT=text, LOG_QUIET_HEALTH=1)
# LOG_LEVEL=DEBUG
# LOG_FORMAT=json
# LOG_COLOR=never   # auto | always | never — text logs only; json stays plain
# LOG_VERBOSE_HEALTH=1
